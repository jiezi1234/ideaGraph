# OpenAlex API 地址，用于检索种子论文和扩展引用关系。
# 网页工作台访问口令：部署时生成至少 24 字符的随机值，不能使用模型 API key。
WEB_ACCESS_TOKEN=

OPENALEX_BASE_URL=https://api.openalex.org

# 追加到 OpenAlex /works 的 filter 参数；topics.field.id:17 表示计算机科学相关论文。
# 使用 topics.field 比 primary_topic.field 召回更高，但仍能过滤掉明显非计算机领域论文。
OPENALEX_WORKS_FILTER=topics.field.id:17

# OpenAlex API key 池，多个 key 用英文逗号分隔；为空时不追加 api_key 参数。
OPENALEX_API_KEYS=

# OpenAlex API key 触发限流或鉴权错误后的临时冷却时间，单位为秒。
OPENALEX_API_KEY_COOLDOWN_SECONDS=300

# OpenAI 兼容模型服务（百炼/DeepSeek/硅基流动等）的端点根地址。
# 只写到域名或 /compatible-mode 也可以，代码会自动补 /v1。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型服务 API key。
LLM_API_KEY=

# 实体/摘要抽取与 idea 生成使用不同档位：抽取量大用便宜模型，生成用质量模型。
LLM_MODEL_EXTRACTION=qwen3.7-flash
LLM_MODEL_GENERATION=qwen3.7-plus

# 模型请求超时时间，单位为秒。
LLM_TIMEOUT=300

# 传给模型的 reasoning_effort；第三方兼容端点未必支持，默认留空。
LLM_THINK_MODE=

# 是否缓存大模型响应，避免重复抽取或生成时反复调用模型。
LLM_CACHE_ENABLED=true

# 大模型响应缓存目录。
LLM_CACHE_DIR=.cache/model_responses

# 向量模型。与 LLM 同厂商时 EMBED_BASE_URL / EMBED_API_KEY 留空即可复用上面配置。
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v4

# 想法生成流程中检索候选论文的数量。
AGENT_RETRIEVAL_TOP_K=3

# chat-idea 每次查询的 JSON 留档目录。
CHAT_IDEA_ARCHIVE_DIR=exports/chat_idea_runs

# Langfuse Cloud tracing 配置。
# 填写 Langfuse 项目里的 public key / secret key 后，chat-idea 会自动写入 trace。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_FLUSH_AT=1

# 论文和查询向量的本地缓存目录。
PAPER_EMBEDDING_CACHE_DIR=.cache/paper_embeddings

# 论文/实体向量缓存未命中时的并发 embedding worker 数。
EMBEDDING_WORKER_COUNT=4

# 论文实体/关系抽取的并发 worker 数。
# 数值越大，Ollama 并发和内存压力越高。
EXTRACTION_WORKER_COUNT=1

# 构图时是否启用语义实体/关系抽取。
EXTRACT_ENTITIES_ENABLED=true

# 是否启用跨论文实体对齐与同 key 关系描述融合；关闭后仅做抽取内归一化写入。
ENTITY_RESOLUTION_ENABLED=true

# 构图实体抽取前是否尝试下载论文 PDF 并抽取 Markdown 全文。
FULL_TEXT_EXTRACTION_ENABLED=true

# PDF 和 Markdown 全文本地产物根目录；实际落盘到 {FULL_TEXT_OUTPUT_DIR}/{NEO4J_DATABASE}/{paper}/。
FULL_TEXT_OUTPUT_DIR=data

# opendataloader-pdf hybrid 后端地址。后端需要由独立服务进程启动。
PDF_HYBRID_URL=http://127.0.0.1:15002

# opendataloader-pdf hybrid 后端名称；当前推荐 docling-fast。
PDF_HYBRID_BACKEND=docling-fast

# hybrid 抽取模式，当前默认 auto。
PDF_HYBRID_MODE=auto

# 引用图扩展策略：one_hop 或 priority_expand。
CITATION_GRAPH_STRATEGY=priority_expand

# priority_expand 策略下种子论文的最低被引次数。
CITATION_SEED_MIN_CITED_BY_COUNT=100

# priority_expand 策略下种子论文的最早发表年份。
CITATION_SEED_MIN_PUBLICATION_YEAR=2021

# 引用扩展过程中最多收集的论文总数。
CITATION_MAX_TOTAL_PAPERS=5000

# Python 日志级别。
LOG_LEVEL=INFO

# 日志文件路径；日志也会同时输出到控制台。
LOG_FILE=logs/ideagraph.log

# Neo4j 连接配置。
NEO4J_URI=bolt://10.160.4.178:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j102
NEO4J_DATABASE=testbus

# chunk 切分使用与生成长度对齐的 HuggingFace tokenizer。
# 本地没有 tokenizer 时填仓库名，并把 LOCAL_FILES_ONLY 设为 false 允许下载。
CHUNK_TOKENIZER_MODEL_PATH=Qwen/Qwen3-8B
CHUNK_TOKENIZER_LOCAL_FILES_ONLY=false

# Graphistry 图谱可视化脚本使用；默认服务器可不填 GRAPHISTRY_SERVER。
GRAPHISTRY_PERSONAL_KEY_ID=UVM3BSX6F9
GRAPHISTRY_PERSONAL_KEY_SECRET=L4RGHGIJ01H0F7B3
GRAPHISTRY_SERVER=
